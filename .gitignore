migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Postman workspace files
.postman/
postman/

# Push notifications (Issue #421): Firebase and Apple keys never belong here.
# A service account is the backend's credential; an APNs key is uploaded to
# Firebase. Neither is needed to build the app.
*firebase-adminsdk*.json
*service-account*.json
*.p8
# The project's app configuration is added locally until its owner decides
# whether to commit it (DATA_AND_API.md §1.2).
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
# The iOS values for --dart-define-from-file; the committed
# firebase_ios.example.json shows the keys.
/firebase_ios.local.json
